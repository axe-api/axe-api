{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./types"],
    "lib": ["ESNext", "dom"],
    "paths": {
      "@/*": ["./src/*"] // ← sadece bunu değiştir
    }
  },
  "include": ["src/**/*", "index.ts", "types/**/*"]
}
